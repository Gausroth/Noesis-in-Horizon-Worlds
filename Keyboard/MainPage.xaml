            <TextBlock Text="*" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="8" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row1Key10" Width="100" Height="100" BorderBrush="{x:Null}" Margin="5,0,5,0" Command="{Binding Path=KeyPressed}" CommandParameter="9(" Background="#FF000000">
          <StackPanel Width="84" Height="86">
            <TextBlock Text="(" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="9" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row1Key11" Width="100" Height="100" BorderBrush="{x:Null}" Margin="5,0,5,0" Command="{Binding Path=KeyPressed}" CommandParameter="0)" Background="#FF000000">

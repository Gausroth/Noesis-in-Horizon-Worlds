          </StackPanel>
        </Button>
        <Button x:Name="Row1Key7" Width="100" Height="100" BorderBrush="{x:Null}" Margin="5,0,5,0" Command="{Binding Path=KeyPressed}" CommandParameter="6^" Background="#FF000000">

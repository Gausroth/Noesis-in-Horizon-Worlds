        <Button x:Name="Row3Key5" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="F" Command="{Binding Path=KeyPressed}" CommandParameter="F" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row3Key6" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="G" Command="{Binding Path=KeyPressed}" CommandParameter="G" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row3Key7" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="H" Command="{Binding Path=KeyPressed}" CommandParameter="H" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row3Key8" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="J" Command="{Binding Path=KeyPressed}" CommandParameter="J" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row3Key9" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="K" Command="{Binding Path=KeyPressed}" CommandParameter="K" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row3Key10" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="L" Command="{Binding Path=KeyPressed}" CommandParameter="L" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row3Key11" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Command="{Binding Path=KeyPressed}" CommandParameter=";:" Background="#FF000000">
          <StackPanel Width="84" Height="86">
            <TextBlock Text=":" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text=";" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row3Key12" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Command="{Binding Path=KeyPressed}" CommandParameter="&apos;&quot;" Background="#FF000000">
          <StackPanel Width="84" Height="86">
            <TextBlock Text="&quot;" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="&apos;" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row3Key13" Width="210" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Content="ENTER" Command="{Binding Path=KeyPressed}" CommandParameter="ENTER" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
      </StackPanel>
      <StackPanel x:Name="Row4" Height="100" Orientation="Horizontal" Margin="5,5,5,5">
        <Button x:Name="Row4Key1" Width="200" Height="100" Margin="5,0,5,0" Background="{Binding Path=RowFourButtonOneButtonColor}" BorderBrush="{x:Null}" FontSize="25" Content="SHIFT" Command="{Binding Path=KeyPressed}" CommandParameter="SHIFT" Foreground="{Binding Path=FontColor}"/>
        <Button x:Name="Row4Key2" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="Z" Command="{Binding Path=KeyPressed}" CommandParameter="Z" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row4Key3" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="X" Command="{Binding Path=KeyPressed}" CommandParameter="X" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row4Key4" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="C" Command="{Binding Path=KeyPressed}" CommandParameter="C" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row4Key5" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="V" Command="{Binding Path=KeyPressed}" CommandParameter="V" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row4Key6" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="B" Command="{Binding Path=KeyPressed}" CommandParameter="B" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row4Key7" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="N" Command="{Binding Path=KeyPressed}" CommandParameter="N" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>

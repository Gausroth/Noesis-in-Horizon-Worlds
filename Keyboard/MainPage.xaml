        <Button x:Name="Row3Key3" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="S" Command="{Binding Path=KeyPressed}" CommandParameter="S" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>

            <TextBlock Text=")" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="0" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row1Key12" Width="100" Height="100" BorderBrush="{x:Null}" Margin="5,0,5,0" Command="{Binding Path=KeyPressed}" CommandParameter="-_" Background="#FF000000">
          <StackPanel Width="84" Height="86">
            <TextBlock Text="_" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="-" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row1Key13" Width="100" Height="100" BorderBrush="{x:Null}" Margin="5,0,5,0" Command="{Binding Path=KeyPressed}" CommandParameter="=+" Background="#FF000000">
          <StackPanel Width="84" Height="86">
            <TextBlock Text="+" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="=" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row1Key14" Width="175" Height="100" Content="BACKSPACE" BorderBrush="{x:Null}" Margin="5,0,5,0" FontSize="25" Command="{Binding Path=KeyPressed}" CommandParameter="BACKSPACE" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
      </StackPanel>
      <StackPanel x:Name="Row2" Height="100" Orientation="Horizontal" Margin="5,5,5,5">
        <Button x:Name="Row2Key1" Width="150" Height="100" Content="TAB" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="TAB" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key2" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="Q" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="Q" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key3" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="W" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="W" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key4" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="E" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="E" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key5" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="R" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="R" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key6" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="T" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="T" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key7" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="Y" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="Y" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>

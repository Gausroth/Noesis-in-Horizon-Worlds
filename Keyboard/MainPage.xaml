            <TextBlock Text="^" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="6" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>

        <Button x:Name="Row2Key9" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="I" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="I" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key10" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="O" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="O" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key11" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="40" Content="P" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="P" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row2Key12" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="[{" Background="#FF000000">
          <StackPanel Width="84" Height="86">
            <TextBlock Text="{}{" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="[" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row2Key13" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="]}" Background="#FF000000">
          <StackPanel Width="84" Height="86">
            <TextBlock Text="}" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="]" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row2Key14" Width="125" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Command="{Binding Path=KeyPressed, StringFormat=F0}" CommandParameter="\|" Background="#FF000000">
          <StackPanel Width="84" Height="86">
            <TextBlock Text="|" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="\" TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel x:Name="Row3" Height="100" Orientation="Horizontal" Margin="5,5,5,5">
        <Button x:Name="Row3Key1" Width="175" Height="100" Margin="5,0,5,0" Background="{Binding Path=RowThreeButtonOneButtonColor}" BorderBrush="{x:Null}" FontSize="25" Content="CAPS LOCK" Command="{Binding Path=KeyPressed}" CommandParameter="CAPS LOCK" Foreground="{Binding Path=FontColor}"/>

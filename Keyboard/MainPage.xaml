            <TextBlock Text="&gt;" TextWrapping="Wrap" FontSize="25" Foreground="{Binding Path=FontColor}"/>
            <TextBlock Text="." TextWrapping="Wrap" FontSize="40" TextAlignment="Center" Foreground="{Binding Path=FontColor}"/>
          </StackPanel>
        </Button>
        <Button x:Name="Row4Key11" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Command="{Binding Path=KeyPressed}" CommandParameter="/?" Background="#FF000000">

        <Button x:Name="Row4Key10" Width="100" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}" FontSize="25" Command="{Binding Path=KeyPressed}" CommandParameter=".&gt;" Background="#FF000000">

        <Button x:Name="Row4Key12" Width="295" Height="100" Margin="5,0,5,0" Background="{Binding Path=RowFourButtonTwelveButtonColor}" BorderBrush="{x:Null}" FontSize="25" Content="SHIFT" Command="{Binding Path=KeyPressed}" CommandParameter="SHIFT" Foreground="{Binding Path=FontColor}"/>
      </StackPanel>
      <StackPanel x:Name="Row5" Height="100" Orientation="Horizontal" Margin="5,5,5,5">
        <Button x:Name="Row5Key1" Height="100" BorderBrush="{x:Null}" FontSize="25" Content="SPACE" Width="550" Margin="532.5,0,112,0" Command="{Binding Path=KeyPressed}" CommandParameter="SPACE" Foreground="{Binding Path=FontColor}" Background="#FF000000"/>
        <Button x:Name="Row5Key2" Width="130" FontSize="40" Background="{Binding Path=RButtonColor}" Content="{Binding Path=R}" Command="{Binding Path=KeyPressed}" CommandParameter="RCOLOR" Foreground="{Binding Path=FontColor}" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}"/>
        <Button x:Name="Row5Key3" Width="130" FontSize="40" Background="{Binding Path=GButtonColor}" Content="{Binding Path=G}" Command="{Binding Path=KeyPressed}" CommandParameter="GCOLOR" Foreground="{Binding Path=FontColor}" Height="100" Margin="5,0,5,0" BorderBrush="{x:Null}"/>
